# ─── Database ───
# For local dev with PostgreSQL:
#   DATABASE_URL="postgresql://user:password@localhost:5432/cropstocks"
# For Render cloud (auto-set by render.yaml):
#   DATABASE_URL is set automatically from the provisioned database
DATABASE_URL="postgresql://user:password@localhost:5432/cropstocks"

# ─── Auth ───
JWT_SECRET="cropstocks-super-secret-key-change-in-production-2024"

# ─── Server ───
PORT=5000

# ─── Sentinel Hub (Copernicus) ───
SENTINEL_CLIENT_ID="your-sentinel-client-id"
SENTINEL_CLIENT_SECRET="your-sentinel-client-secret"
