// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums (SQLite doesn't support enums natively, using String) ───

// Role: FARMER, INVESTOR, ADMIN, FIELD_AGENT, VENDOR
// ListingType: CROP, ANIMAL
// ListingStatus: PENDING, APPROVED, FUNDING, ACTIVE, HARVESTED, FAILED, CLOSED
// RiskTier: LOW, MEDIUM, HIGH
// KYCStatus: PENDING, VERIFIED, REJECTED
// PayoutType: PROFIT, PRINCIPAL, INSURANCE
// PayoutStatus: PENDING, PAID, INSURANCE_PAID

model User {
  id            String   @id @default(uuid())
  role          String   @default("FARMER") // FARMER, INVESTOR, ADMIN, FIELD_AGENT, VENDOR
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String
  kycStatus     String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  language      String   @default("en") // en, hi
  linkedBank    String?
  linkedUPI     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farmerProfile   FarmerProfile?
  investorProfile InvestorProfile?
  listings        Listing[]
  investments     Investment[]
  payouts         Payout[]        @relation("RecipientPayouts")
  progressUpdates ProgressUpdate[] @relation("VerifiedBy")
  auditLogs       AuditLog[]
  cropCycles      CropCycleState[] @relation("FarmerCycles")

  sellerProfile      SellerProfile?
  martCart           MartCart?
  martOrders         MartOrder[]
  martReviews        MartReview[]
  martWishlist       MartWishlist[]
  martAddresses      MartAddress[]
  sentMessages       MartMessage[]         @relation("SentMessages")
  receivedMessages   MartMessage[]         @relation("ReceivedMessages")
  martQuoteRequests  MartQuoteRequest[]    @relation("BuyerQuotes")
  martQuestions      MartProductQuestion[]
}

model FarmerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  aadhaarNo          String?
  panNo              String?
  landDetails        String?  // JSON string
  farmAddress        String?
  farmSize           String?  // e.g., "5 acres"
  latitude           Float?
  longitude          Float?
  verificationStatus String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationNotes  String?
  documents          String?  // JSON array of file paths
  polygonId          String?
  satelliteStatus    String?  // pending, ready, unavailable, not_found
  latestAcquisitionDate String?
  truecolorUrl       String?
  ndviUrl            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model InvestorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  walletBalance  Float    @default(0)
  totalInvested  Float    @default(0)
  totalReturns   Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Listing {
  id                 String   @id @default(uuid())
  farmerId           String
  farmer             User     @relation(fields: [farmerId], references: [id])
  type               String   // CROP, ANIMAL
  produceName        String
  region             String
  location           String?
  landSize           String?  // for crops
  animalCount        Int?     // for animal husbandry
  capitalRequired    Float
  capitalRaised      Float    @default(0)
  inputBreakdown     String?  // JSON: [{name, quantity, unitCost, totalCost}]
  profitSplitFarmer  Float    @default(60) // percentage
  profitSplitInvestor Float   @default(40) // percentage
  status             String   @default("PENDING") // PENDING, APPROVED, FUNDING, ACTIVE, HARVESTED, FAILED, CLOSED
  insuranceFlag      Boolean  @default(true)
  riskTier           String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  cycleDuration      Int      // in days
  expectedYield      String?
  expectedPrice      Float?
  expectedReturn     Float?   // percentage return for investors
  ndviScore          Float?   // 0.0 to 1.0 — vegetation health from satellite
  stockPrice         Float?   // computed stock price per share unit
  vegetationStatus   String?  // Excellent, Good, Fair, Poor, Critical
  milestones         String?  // JSON: [{name, date, status}]
  harvestQuantity    String?
  harvestRevenue     Float?
  harvestProof       String?  // file path
  startDate          DateTime?
  endDate            DateTime?
  approvedAt         DateTime?
  fundedAt           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  investments     Investment[]
  progressUpdates ProgressUpdate[]
  inputOrders     InputOrder[]
  insuranceClaims InsuranceClaim[]
  payouts         Payout[]
  guidanceTips    GuidanceTip[]
  cropCycleStates CropCycleState[]
}

model Investment {
  id           String   @id @default(uuid())
  investorId   String
  investor     User     @relation(fields: [investorId], references: [id])
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id])
  amount       Float
  sharePercent Float    // percentage of total capital this investment represents
  payoutStatus String   @default("PENDING") // PENDING, PAID, INSURANCE_PAID
  payoutAmount Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProgressUpdate {
  id         String   @id @default(uuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id])
  stage      String   // SOWING, GROWTH, MID_CYCLE, PRE_HARVEST, HARVEST
  notes      String
  mediaUrls  String?  // JSON array of file paths
  verifiedBy String?
  verifier   User?    @relation("VerifiedBy", fields: [verifiedBy], references: [id])
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model GuidanceTip {
  id             String  @id @default(uuid())
  listingId      String?
  listing        Listing? @relation(fields: [listingId], references: [id])
  applicableType String  // CROP, ANIMAL, or specific produce name
  stage          String  // SOWING, GROWTH, MID_CYCLE, PRE_HARVEST, HARVEST
  content        String
  language       String  @default("en")
}

model InputOrder {
  id                String   @id @default(uuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id])
  supplierId        String?
  items             String   // JSON: [{name, quantity, unitPrice, totalPrice}]
  status            String   @default("PENDING") // PENDING, ORDERED, SHIPPED, DELIVERED
  deliveryConfirmed Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InsuranceClaim {
  id           String   @id @default(uuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id])
  reason       String
  evidence     String?  // JSON array of file paths / descriptions
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  payoutAmount Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Payout {
  id          String   @id @default(uuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  recipientId String
  recipient   User     @relation("RecipientPayouts", fields: [recipientId], references: [id])
  amount      Float
  type        String   // PROFIT, PRINCIPAL, INSURANCE
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    String?  // JSON
  createdAt  DateTime @default(now())
}

model SurveyResponse {
  id        String   @id @default(uuid())
  data      String   // JSON string containing all form answers
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════
// ═══ WEEKLY VALUATION LOOP MODELS (T0–T7) ═══════════════════════
// ═══════════════════════════════════════════════════════════════════

// Loop state object — the loop's persistent memory (spec §2)
// One per farmer per listing per crop cycle.
// Read at T0 (start of week), written at T7 (end of week).
model CropCycleState {
  id                           String   @id @default(uuid())
  farmerId                     String
  farmer                       User     @relation("FarmerCycles", fields: [farmerId], references: [id])
  listingId                    String
  listing                      Listing  @relation(fields: [listingId], references: [id])
  cycleWeek                    Int      @default(1)
  cropStage                    String   @default("VEGETATIVE") // VEGETATIVE, FLOWERING, FRUITING, MATURITY
  status                       String   @default("ACTIVE") // ACTIVE, HARVEST_CONFIRMED, PLOT_ABANDONED, CONTRACT_TERMINATED
  geofenceLat                  Float
  geofenceLng                  Float
  geofenceRadiusM              Float    @default(150)
  capitalGrantedInr            Float    @default(0)
  capitalDisbursedInr          Float    @default(0)
  currentPriceInr              Float    @default(0)
  priceHistory                 String   @default("[]") // JSON: [{week, price, delta}]
  healthIndexHistory           String   @default("[]") // JSON: [{week, index, confidence}]
  openDiseaseFlags             String   @default("[]") // JSON: [{disease, severity, flaggedWeek}]
  consecutiveMissedSubmissions Int      @default(0)
  trustScore                   Float    @default(0.5)
  lastReportId                 String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  submissionWindows  SubmissionWindow[]
  submissions        FarmerSubmission[]
  satelliteSnapshots SatelliteSnapshot[]
  reports            WeeklyCropReport[]
  priceChanges       PriceChange[]
  appeals            FarmerAppeal[]
}

// T0 — OPEN_WINDOW output
// Tracks the 72-hour submission window per ISO week.
model SubmissionWindow {
  id           String         @id @default(uuid())
  cycleStateId String
  cycleState   CropCycleState @relation(fields: [cycleStateId], references: [id])
  cycleWeek    Int
  opensAt      DateTime
  closesAt     DateTime
  status       String         @default("OPEN") // OPEN, CLOSED, MISSED
  notifiedAt   DateTime?
  createdAt    DateTime       @default(now())
}

// T0 — Satellite snapshot pre-fetched each week
model SatelliteSnapshot {
  id              String         @id @default(uuid())
  cycleStateId    String
  cycleState      CropCycleState @relation(fields: [cycleStateId], references: [id])
  cycleWeek       Int
  truecolorUrl    String?
  ndviUrl         String?
  ndviMean        Float?
  ndviDelta       Float? // delta vs previous week
  ndwiMean        Float?
  ndwiDelta       Float?
  acquisitionDate String?
  cloudCoverPct   Float?
  createdAt       DateTime       @default(now())
}

// T1 — CAPTURE: Farmer submission (images + bills)
model FarmerSubmission {
  id                       String         @id @default(uuid())
  cycleStateId             String
  cycleState               CropCycleState @relation(fields: [cycleStateId], references: [id])
  cycleWeek                Int
  status                   String         @default("PENDING") // PENDING, VERIFIED, REJECTED, RESUBMIT
  resubmitCount            Int            @default(0)
  rejectionReason          String?
  rejectionReasonLocalized String? // JSON: {en, hi, gu}
  submittedAt              DateTime       @default(now())
  verifiedAt               DateTime?

  images       SubmissionImage[]
  bills        SubmissionBill[]
  verification VerificationResult?
  analysis     CropHealthAnalysis?
}

// T1 — Individual geotagged crop images
model SubmissionImage {
  id               String           @id @default(uuid())
  submissionId     String
  submission       FarmerSubmission @relation(fields: [submissionId], references: [id])
  fileUrl          String
  captureLat       Float
  captureLng       Float
  captureAccuracyM Float
  serverTimestamp  DateTime         @default(now())
  perceptualHash   String? // for novelty check (T2)
  subLocationIndex Int // which sub-location (≥3 distinct required)
}

// T1 — Agricultural bills with OCR data
model SubmissionBill {
  id              String           @id @default(uuid())
  submissionId    String
  submission      FarmerSubmission @relation(fields: [submissionId], references: [id])
  fileUrl         String
  fileType        String // IMAGE, PDF
  ocrConfidence   Float?
  extractedVendor String?
  extractedDate   String?
  extractedAmount Float?
  extractedItems  String? // JSON array of line items
  isValid         Boolean          @default(false)
  createdAt       DateTime         @default(now())
}

// T2 — VERIFY: Gate verification result
model VerificationResult {
  id                       String           @id @default(uuid())
  submissionId             String           @unique
  submission               FarmerSubmission @relation(fields: [submissionId], references: [id])
  geofencePass             Boolean
  livenessPass             Boolean
  noveltyPass              Boolean
  legibilityPass           Boolean
  billSanityPass           Boolean
  overallPass              Boolean
  failureReason            String?
  failureReasonLocalized   String? // JSON: {en, hi, gu}
  checkedAt                DateTime         @default(now())
}

// T3 — ANALYSE: Crop health pipeline output
model CropHealthAnalysis {
  id             String           @id @default(uuid())
  submissionId   String           @unique
  submission     FarmerSubmission @relation(fields: [submissionId], references: [id])
  healthIndex    Float // 0–100
  confidence     Float // 0–1
  growthStageEst String? // model's estimate of crop stage
  anomalyFlags   String           @default("[]") // JSON array
  modelVersion   String
  kbVersion      String
  analyzedAt     DateTime         @default(now())

  detections   HealthDetection[]
  remediations RemediationCard[]
}

// T3 — Individual disease/pest detections
model HealthDetection {
  id          String             @id @default(uuid())
  analysisId  String
  analysis    CropHealthAnalysis @relation(fields: [analysisId], references: [id])
  diseaseName String
  severity    String // LOW, MODERATE, SEVERE
  affectedPct Float
  confidence  Float
}

// T4 — ADVISE: Remediation advisory cards
model RemediationCard {
  id                  String             @id @default(uuid())
  analysisId          String
  analysis            CropHealthAnalysis @relation(fields: [analysisId], references: [id])
  diseaseName         String
  explanation         String // JSON: {en, hi, gu}
  treatment           String // JSON: {en, hi, gu}
  dosage              String?
  urgencyLevel        String // LOW, MEDIUM, HIGH, CRITICAL
  expectedYieldImpact String?
  estimatedCostInr    Float?
  followUpFlag        Boolean            @default(true)
}

// T5 — REPORT: Immutable weekly crop report
model WeeklyCropReport {
  id           String         @id @default(uuid())
  cycleStateId String
  cycleState   CropCycleState @relation(fields: [cycleStateId], references: [id])
  cycleWeek    Int
  contentHash  String // SHA-256 hash of reportData for immutability
  reportData   String // JSON: full report content (all 9 sections)
  status       String         @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, MANUAL_REVIEW
  reviewerId   String?
  reviewNotes  String?
  modelVersion String
  kbVersion    String
  createdAt    DateTime       @default(now())
  approvedAt   DateTime?

  priceChange PriceChange?
}

// T7 — REPRICE: Price change record with factor attribution
model PriceChange {
  id                      String           @id @default(uuid())
  cycleStateId            String
  cycleState              CropCycleState   @relation(fields: [cycleStateId], references: [id])
  reportId                String           @unique
  report                  WeeklyCropReport @relation(fields: [reportId], references: [id])
  cycleWeek               Int
  priorPriceInr           Float
  newPriceInr             Float
  deltaPercent            Float
  clamped                 Boolean          @default(false)
  circuitBreakerTriggered Boolean          @default(false)
  publishAt               DateTime // Friday 18:00 IST
  published               Boolean          @default(false)

  attributions PriceAttribution[]
  createdAt    DateTime           @default(now())
}

// T7 — Per-factor price attribution (auditable breakdown)
model PriceAttribution {
  id            String      @id @default(uuid())
  priceChangeId String
  priceChange   PriceChange @relation(fields: [priceChangeId], references: [id])
  factor        String // HEALTH_INDEX, GROWTH_STAGE, INPUT_COMPLIANCE, MARKET_SIGNAL, DISEASE_PENALTY, NON_SUBMISSION_PENALTY
  weight        Float
  rawValue      Float
  basisPoints   Float // contribution in basis points
  description   String?
}

// Appeals — Farmer dispute mechanism
model FarmerAppeal {
  id              String         @id @default(uuid())
  cycleStateId    String
  cycleState      CropCycleState @relation(fields: [cycleStateId], references: [id])
  cycleWeek       Int
  appealType      String // HEALTH_SCORE, PRICE_MOVE
  reason          String
  status          String         @default("PENDING") // PENDING, UNDER_REVIEW, UPHELD, OVERTURNED
  resolutionNotes String?
  fieldAgentId    String?
  slaDeadline     DateTime
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?
}


// ─── CROPMART MODULE MODELS ───

model SellerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  businessName     String
  gstNumber        String?
  idProofUrl       String?
  bankAccountNo    String?
  bankIfsc         String?
  pickupAddress    String?
  pickupPincode    String?
  pickupLat        Float?
  pickupLng        Float?
  isVerified       Boolean  @default(false)
  verifiedAt       DateTime?
  rejectionReason  String?
  commissionRate   Float    @default(10.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products         MartProduct[]
  martQuoteRequests MartQuoteRequest[]
  martOrderItems   MartOrderItem[]
}

model MartCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  iconUrl     String?
  parentId    String?
  parent      MartCategory?  @relation("SubCategories", fields: [parentId], references: [id])
  children    MartCategory[] @relation("SubCategories")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  products    MartProduct[]
}

model MartProduct {
  id                 String   @id @default(uuid())
  sellerId           String
  seller             SellerProfile @relation(fields: [sellerId], references: [id])
  categoryId         String
  category           MartCategory @relation(fields: [categoryId], references: [id])
  title              String
  slug               String   @unique
  description        String?
  specifications     String?  // JSON string
  brand              String?
  price              Float
  discountPercent    Float    @default(0)
  quantity           Int
  unit               String   // kg/quintal/piece/unit
  condition          String   // NEW/USED/REFURBISHED
  isRentalAvailable  Boolean  @default(false)
  rentalPricePerDay  Float?
  rentalPricePerHour Float?
  images             String?  // JSON string array
  videoUrl           String?
  warranty           String?
  deliveryCharges    Float    @default(0)
  location           String?
  pincode            String?
  latitude           Float?
  longitude          Float?
  certifications     String?
  batchNumber        String?
  expiryDate         DateTime?
  govSubsidyTag      String?
  isApproved         Boolean  @default(false)
  isFeatured         Boolean  @default(false)
  approvedAt         DateTime?
  status             String   @default("DRAFT") // DRAFT/PENDING/ACTIVE/OUT_OF_STOCK/ARCHIVED
  avgRating          Float    @default(0)
  totalReviews       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cartItems          MartCartItem[]
  orderItems         MartOrderItem[]
  reviews            MartReview[]
  wishlistItems      MartWishlist[]
  questions          MartProductQuestion[]
  quoteRequests      MartQuoteRequest[]
  messages           MartMessage[]
}

model MartCart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     MartCartItem[]
}

model MartCartItem {
  id              String   @id @default(uuid())
  cartId          String
  cart            MartCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         MartProduct @relation(fields: [productId], references: [id])
  quantity        Int
  rentalStartDate DateTime?
  rentalEndDate   DateTime?
  createdAt       DateTime @default(now())
}

model MartWishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   MartProduct @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model MartAddress {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  label        String   // Home/Office/Farm
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  orders       MartOrder[]
}

model MartOrder {
  id                 String   @id @default(uuid())
  orderNumber        String   @unique
  buyerId            String
  buyer              User     @relation(fields: [buyerId], references: [id])
  addressId          String
  address            MartAddress @relation(fields: [addressId], references: [id])
  subtotal           Float
  deliveryTotal      Float
  discountTotal      Float
  taxTotal           Float
  grandTotal         Float
  couponId           String?
  coupon             MartCoupon? @relation(fields: [couponId], references: [id])
  status             String   @default("PLACED") // PLACED/CONFIRMED/SHIPPED/OUT_FOR_DELIVERY/DELIVERED/CANCELLED/RETURN_REQUESTED/RETURNED/REFUNDED
  paymentMethod      String
  paymentStatus      String   @default("PENDING") // PENDING/PAID/FAILED/REFUNDED
  paymentId          String?
  cancellationReason String?
  returnReason       String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items              MartOrderItem[]
  statusHistory      MartOrderStatus[]
  payments           MartPayment[]
  reviews            MartReview[]
}

model MartOrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           MartOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         MartProduct @relation(fields: [productId], references: [id])
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id])
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  isRental        Boolean  @default(false)
  rentalStartDate DateTime?
  rentalEndDate   DateTime?
  status          String   @default("PLACED")
  trackingId      String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
}

model MartOrderStatus {
  id        String   @id @default(uuid())
  orderId   String
  order     MartOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model MartPayment {
  id              String   @id @default(uuid())
  orderId         String
  order           MartOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          String
  amount          Float
  transactionId   String?
  status          String   // INITIATED/SUCCESS/FAILED/REFUNDED
  gatewayResponse String?  // JSON
  createdAt       DateTime @default(now())
}

model MartReview {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  productId          String
  product            MartProduct @relation(fields: [productId], references: [id])
  orderId            String?
  order              MartOrder? @relation(fields: [orderId], references: [id])
  rating             Int
  title              String?
  comment            String?
  images             String?  // JSON string
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MartCoupon {
  id             String   @id @default(uuid())
  code           String   @unique
  description    String?
  discountType   String   // PERCENT/FLAT
  discountValue  Float
  minOrderAmount Float
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int      @default(0)
  validFrom      DateTime
  validTo        DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  orders         MartOrder[]
}

model MartMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  productId  String?
  product    MartProduct? @relation(fields: [productId], references: [id])
  subject    String?
  body       String
  isRead     Boolean  @default(false)
  parentId   String?
  parent     MartMessage?  @relation("ThreadMessages", fields: [parentId], references: [id])
  replies    MartMessage[] @relation("ThreadMessages")
  createdAt  DateTime @default(now())
}

model MartBanner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  position  Int
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
}

model MartQuoteRequest {
  id             String   @id @default(uuid())
  buyerId        String
  buyer          User     @relation("BuyerQuotes", fields: [buyerId], references: [id])
  productId      String
  product        MartProduct @relation(fields: [productId], references: [id])
  sellerId       String
  seller         SellerProfile @relation(fields: [sellerId], references: [id])
  quantity       Int
  message        String?
  offeredPrice   Float?
  status         String   @default("PENDING") // PENDING/RESPONDED/ACCEPTED/REJECTED
  sellerResponse String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MartProductQuestion {
  id         String   @id @default(uuid())
  productId  String
  product    MartProduct @relation(fields: [productId], references: [id])
  askerId    String
  asker      User     @relation(fields: [askerId], references: [id])
  question   String
  answer     String?
  answeredBy String?
  answeredAt DateTime?
  createdAt  DateTime @default(now())
}
